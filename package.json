{
  "name": "cars-shop",
  "version": "1.0.0",
  "private": false,
  "description": "A full-stack ASP.NET MVC web application simulating an online car dealership with multi-currency support and dynamic pricing. Combining server-side C# with AngularJS 1.6, it delivers an interactive car shopping experience featuring real-time currency conversion, responsive and modern UI interactions",
  "keywords": [
    "aspnet",
    "mvc",
    "csharp",
    "angularjs",
    "bootstrap",
    "webapi",
    "rest-api",
    "car-dealership",
    "ecommerce",
    "multi-currency",
    "responsive-design",
    "json-data",
    "dotnet",
    "web-application"
  ],
  "homepage": "https://github.com/orassayag/cars-shop#readme",
  "bugs": {
    "url": "https://github.com/orassayag/cars-shop/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/orassayag/cars-shop.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/orassayag"
  },
  "license": "MIT",
  "author": {
    "name": "Or Assayag",
    "email": "orassayag@gmail.com",
    "url": "https://github.com/orassayag"
  },
  "contributors": [
    {
      "name": "Or Assayag",
      "email": "orassayag@gmail.com",
      "url": "https://github.com/orassayag"
    }
  ],
  "type": "module",
  "main": "CarShop/Global.asax.cs",
  "files": [
    ".github",
    ".vs",
    ".vscode",
    "CarShop",
    "packages",
    ".eslintrc",
    ".gitignore",
    ".prettierrc",
    "CarShop.sln",
    "CarShop.v11.suo",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "desktop.ini",
    "INSTRUCTIONS.md",
    "LICENSE",
    "package.json",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "start": "tsx src/index.ts",
    "start:live": "cross-env DRY_MODE=false tsx src/index.ts",
    "start:no-cache": "tsx src/index.ts --no-cache",
    "sync": "tsx src/index.ts --auto",
    "test": "cross-env NODE_OPTIONS='--no-warnings' vitest run --coverage",
    "test:no-coverage": "cross-env NODE_OPTIONS='--no-warnings' vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "cross-env NODE_OPTIONS='--no-warnings' vitest"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rolldown/binding-win32-x64-msvc": "^1.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
